<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- keep in step with spring-boot.version in virtuoso-bom/pom.xml -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath /> <!-- lookup parent from repository -->
    </parent>

    <groupId>io.github.positivinh.virtuoso</groupId>
    <artifactId>virtuoso</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>virtuoso software factory</name>
    <description>building blocks for software production</description>
    <url>https://github.com/positivinh/virtuoso</url>

    <modules>
        <module>virtuoso-bom</module>
        <module>virtuoso-parent</module>
        <module>virtuoso-spring-boot-parent</module>
        <module>dummy-project</module>
        <module>virtuoso-domain-validation</module>
        <module>virtuoso-data-mongodb</module>
        <module>virtuoso-jwt</module>
        <module>virtuoso-authorization</module>
        <module>virtuoso-web-security</module>
        <module>virtuoso-web-mvc</module>
        <module>virtuoso-observability</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <!-- publishing plugins: declared here, not in virtuoso-bom, because this POM uses them too -->
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>


    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <url>https://github.com/positivinh/virtuoso</url>
        <tag>HEAD</tag>
        <connection>scm:git:https://github.com/positivinh/virtuoso</connection>
    </scm>

    <profiles>
        <profile>
            <id>github</id>
            <distributionManagement>
                <repository>
                    <id>github</id>
                    <name>GitHub positivinh Apache Maven Packages</name>
                    <url>https://maven.pkg.github.com/positivinh/virtuoso</url>
                </repository>
            </distributionManagement>
        </profile>
        <profile>
            <id>maven-central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <!-- the plugin ignores maven.deploy.skip: keep in step with the *dummy-project modules -->
                            <excludeArtifacts>
                                <artifact>dummy-project</artifact>
                                <artifact>domain-validation-dummy-project</artifact>
                                <artifact>mongodb-dummy-project</artifact>
                                <artifact>jwt-dummy-project</artifact>
                                <artifact>authorization-dummy-project</artifact>
                                <artifact>web-security-dummy-project</artifact>
                                <artifact>web-mvc-dummy-project</artifact>
                                <artifact>observability-dummy-project</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
